NODE_ENV=development
PORT=4000

# LLM
OPENAI_API_KEY=your_openai_api_key

# Storage — S3 (Floci locally, real AWS or MinIO in production)
S3_BUCKET=explainit
S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# S3_FORCE_PATH_STYLE=true

# Auth. none = no login (Compose / local). oidc = any JWKS issuer
# (Authentik, Keycloak, Auth0, Kinde). password = single env user.
AUTH_MODE=none
ADMIN_EMAIL=admin@example.com

# password mode
# AUTH_SECRET=replace-with-a-long-random-string
# ADMIN_PASSWORD=changeme

# oidc mode — Kinde is one possible issuer, not a required dependency
# AUTH_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
# AUTH_ISSUER=https://your-idp.example.com
# AUTH_AUDIENCE=explainit

# Database
DATABASE_URL=postgresql://explainit:explainit@localhost:5432/explainit

# Emails (optional). Leave unset to boot without a mail provider.
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=noreply@example.com
# CONTACT_EMAIL=support@example.com
