NODE_ENV=development
PORT=4000

# Payments
LEMONSQUEEZY_PRO_VARIANT_ID=your_lemonsqueezy_pro_variant_id
LEMONSQUEEZY_STORE_ID=your_lemonsqueezy_store_id
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_secret
LEMONSQUEEZY_REDIRECT_URL=https://your-app.example.com/checkout/success

# LLM
OPENAI_API_KEY=your_openai_api_key

# Storage (JSON private keys should keep escaped newlines in .env)
GCP_PROJECT_ID=your_gcp_project_id
GCP_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_key\n-----END PRIVATE KEY-----\n"
GCP_STORAGE_BUCKET=your_gcp_storage_bucket

# Auth
AUTH_JWKS_URI=https://your-auth-provider.example.com/.well-known/jwks.json
ADMIN_EMAIL=admin@example.com

# Database
DATABASE_URL=postgresql://explainit:explainit@localhost:5432/explainit

# Emails
RESEND_FROM_EMAIL=noreply@example.com
RESEND_API_KEY=your_resend_api_key
CONTACT_EMAIL=support@example.com

# Optional if switching to nodemailer provider
# NODEMAILER_EMAIL_USER=your_smtp_user
# NODEMAILER_EMAIL_PASSWORD=your_smtp_password
