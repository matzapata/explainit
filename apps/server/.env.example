# Local only. Production (ECS/Fargate) injects the same keys as container env
# from Secrets Manager / SSM
NODE_ENV=development
PORT=4000

# LLM — OpenRouter (OpenAI-compatible). Any OpenRouter model slug works,
# including OpenAI models (openai/...). Embeddings must stay 1536 dimensions
# (pgvector column is vector(1536)).
OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-ada-002

# Object storage — S3 (Floci locally, real AWS or MinIO in production)
S3_BUCKET=explainit
S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# S3_FORCE_PATH_STYLE=true

# Redis — BullMQ ingest queue and HTTP rate limits (Compose redis).
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth. Unset = no login (Compose / local). Set both username and password
# to require sign-in. AUTH_SECRET is optional; the password is hashed for JWTs
# when it is omitted.
# HTTP_AUTH_USERNAME=admin
# HTTP_AUTH_PASSWORD=changeme
# AUTH_SECRET=replace-with-a-long-random-string

# Database
DATABASE_URL=postgresql://explainit:explainit@localhost:5432/explainit

# Browser origin allowed to call this API. Comma-separated for multiple, or * to allow all.
CORS_ORIGIN=http://localhost:3000

# Observability (Jaeger OTLP). Defaults work with Compose / local Jaeger.
OTEL_SERVICE_NAME=explainit
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
