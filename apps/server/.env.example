NODE_ENV=development
PORT=4000

# LLM
OPENAI_API_KEY=your_openai_api_key

# Storage (JSON private keys should keep escaped newlines in .env)
GCP_PROJECT_ID=your_gcp_project_id
GCP_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_key\n-----END PRIVATE KEY-----\n"
GCP_STORAGE_BUCKET=your_gcp_storage_bucket

# Auth. none = no login (Compose / local). oidc = any JWKS issuer
# (Authentik, Keycloak, Auth0, Kinde). password = single env user.
AUTH_MODE=none
ADMIN_EMAIL=admin@example.com

# password mode
# AUTH_SECRET=replace-with-a-long-random-string
# ADMIN_PASSWORD=changeme

# oidc mode — Kinde is one possible issuer, not a required dependency
# AUTH_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
# AUTH_ISSUER=https://your-idp.example.com
# AUTH_AUDIENCE=explainit

# Database
DATABASE_URL=postgresql://explainit:explainit@localhost:5432/explainit

# Emails
RESEND_FROM_EMAIL=noreply@example.com
RESEND_API_KEY=your_resend_api_key
CONTACT_EMAIL=support@example.com

# Optional if switching to nodemailer provider
# NODEMAILER_EMAIL_USER=your_smtp_user
# NODEMAILER_EMAIL_PASSWORD=your_smtp_password
