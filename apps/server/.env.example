NODE_ENV=development
PORT=4000

# LLM — OpenAI by default. OpenRouter (or any OpenAI-compatible API): set
# OPENAI_BASE_URL and use that provider's model slugs. Embeddings must stay
# 1536 dimensions (pgvector column is vector(1536)).
OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-ada-002

# Storage — S3 (Floci locally, real AWS or MinIO in production)
S3_BUCKET=explainit
S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# S3_FORCE_PATH_STYLE=true

# BullMQ — Redis locally (Compose redis) and in production.
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth. none = no login (Compose / local). oidc = any JWKS issuer
# (Authentik, Keycloak, Auth0, Kinde). password = single env user.
AUTH_MODE=none
ADMIN_EMAIL=admin@example.com

# password mode
# AUTH_SECRET=replace-with-a-long-random-string
# ADMIN_PASSWORD=changeme

# oidc mode — Kinde is one possible issuer, not a required dependency
# AUTH_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
# AUTH_ISSUER=https://your-idp.example.com
# AUTH_AUDIENCE=explainit

# Database
DATABASE_URL=postgresql://explainit:explainit@localhost:5432/explainit

# Browser origin allowed to call this API. Comma-separated for multiple, or * to allow all.
CORS_ORIGIN=http://localhost:3000

# Observability (Jaeger OTLP). Defaults work with Compose / local Jaeger.
OTEL_SERVICE_NAME=explainit
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
