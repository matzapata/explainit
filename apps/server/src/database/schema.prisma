datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

// ============================= user module =============================
model User {
  id    String  @id @default(uuid()) @db.Uuid
  email String  @unique
  name  String?

  createdAt DateTime @default(now())

  subscription UserSubscription?
  chats        Chat[]
}

// ============================= payments module =============================
model UserSubscription {
  id             String    @id @default(uuid()) @db.Uuid
  subscriptionId String
  variantId      String
  orderId        String
  provider       String
  status         String
  renewsAt       DateTime
  endsAt         DateTime?
  trialEndsAt    DateTime?
  pauseMode      String?
  pauseResumesAt DateTime?
  cancelled      Boolean
  billingAnchor  Int
  testMode       Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique @db.Uuid
}

model WebhookEvent {
  id              String  @id @default(uuid()) @db.Uuid
  eventName       String
  processed       Boolean @default(false)
  body            String
  processingError String?

  createdAt DateTime @default(now())
}

// ============================= chat module =============================
model Chat {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String?
  logo                 String?
  url                  String?
  description          String?
  conversationStarters String[]
  published            Boolean  @default(false)
  points               Int      @default(0)

  createdAt DateTime @default(now())

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String @db.Uuid

  resources ChatResource[]

  @@index([ownerId])
}

model ChatResource {
  id           String   @id @default(uuid()) @db.Uuid
  type         String
  data         String
  embeddingIds String[]

  createdAt DateTime @default(now())

  chat   Chat   @relation(fields: [chatId], references: [id])
  chatId String @db.Uuid

  @@index([chatId])
}

model ChatRateLimit {
  key    String    @id
  points Int
  expire DateTime?
}

// ============================= embeddings module =============================
// OpenAI text-embedding-ada-002 (LangChain default) is 1536 dimensions.
// HNSW cosine index is created in the SQL migration; Prisma cannot express USING hnsw.
model Embedding {
  id        String                    @id @default(uuid()) @db.Uuid
  content   String
  namespace String
  metadata  Json
  embedding Unsupported("vector(1536)")

  @@index([namespace])
}
