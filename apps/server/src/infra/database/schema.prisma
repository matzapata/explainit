datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

// ============================= user module =============================
model User {
  id    String  @id @default(uuid()) @db.Uuid
  email String  @unique
  name  String?

  createdAt DateTime @default(now())

  chats Chat[]
}

enum ChatColor {
  purple
  blue
  cyan
  green
  red
  orange
  yellow
  gray
}

// ============================= chat module =============================
model Chat {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String?
  color                ChatColor @default(blue)
  hostOrigins          String[]  @default([])
  description          String?
  conversationStarters String[]
  published            Boolean   @default(false)
  points               Int       @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
  lastUsedAt DateTime?

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String @db.Uuid

  resources     ChatResource[]
  conversations Conversation[]
  messages      Message[]

  @@index([ownerId])
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chat     Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([chatId])
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  chatId         String   @db.Uuid
  role           String
  content        String
  context        Json?
  pageUrl        String?
  selectedText   String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chat         Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([conversationId])
}

enum ResourceStatus {
  pending
  processing
  ready
  failed
}

model ChatResource {
  id           String         @id @default(uuid()) @db.Uuid
  type         String
  data         String
  title        String?
  embeddingIds String[]
  status       ResourceStatus @default(ready)
  error        String?
  /// Shared by all pages from one "Crawl this site" campaign; null for single-page adds.
  crawlId      String?        @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId String @db.Uuid

  @@index([chatId])
  @@index([crawlId])
}

// ============================= embeddings module =============================
// OpenAI text-embedding-ada-002 (LangChain default) is 1536 dimensions.
// HNSW cosine index is created in the SQL migration; Prisma cannot express USING hnsw.
model Embedding {
  id        String                    @id @default(uuid()) @db.Uuid
  content   String
  namespace String
  metadata  Json
  embedding Unsupported("vector(1536)")

  @@index([namespace])
}
