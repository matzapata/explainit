NEXT_PUBLIC_API_SERVER_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_CLIENT_BASE_URL=http://localhost:4000
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# Auth. Must match apps/server AUTH_MODE.
# none: no login (Compose / local).
# oidc: any issuer (Authentik, Keycloak, Auth0, Kinde).
# password: ADMIN_EMAIL + ADMIN_PASSWORD on the API.
NEXT_PUBLIC_AUTH_MODE=none

# OIDC only — Kinde is one possible issuer
# NEXT_PUBLIC_AUTH_ISSUER=https://your-idp.example.com
# NEXT_PUBLIC_AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional: set when client code starts consuming it.
# NEXT_PUBLIC_LOOM_DEMO_URL=https://www.loom.com/share/your-demo-id
