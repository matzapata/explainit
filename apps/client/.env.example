# Leave empty to call /api on the same origin (Vite proxies to the Nest API).
# Production Compose / GHCR client also leave these empty so the browser uses
# window.location.origin (see docs/docker-deployment.md).
# Set absolute URLs only when the UI is not served next to the API.
# VITE_API_BASE_URL=http://localhost:4000

# Public API origin embedded in the Host Install snippet (visitor widget → Nest).
# VITE_PUBLIC_API_URL=http://localhost:4000

# Minified Launcher IIFE. Local Compose uploads it to Floci; production Compose
# serves it from the same origin at /cdn/launcher.js. widget.js/css live beside it.
# VITE_LAUNCHER_SRC=http://localhost:4566/explainit-cdn/launcher.js
