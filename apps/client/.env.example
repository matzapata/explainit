# Leave empty to call /api on the same origin (Vite proxies to the Nest API).
# Set to an absolute API origin only when the UI is not served next to the API.
# VITE_API_BASE_URL=http://localhost:4000

# Minified Launcher IIFE. Local Compose uploads it to Floci; production is the
# CloudFront URL of the uploaded launcher.js.
# VITE_LAUNCHER_SRC=http://localhost:4566/explainit-cdn/launcher.js
