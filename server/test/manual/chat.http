
# Manual testing http requests with extension REST Client

# Admin ========================================================================

### Gets the chat for the owner
GET http://{{host}}/api/chats/admin
Authorization: Bearer {{token}}

### Creates a new chat for the owner. Only admin can have multiple chats
POST  http://{{host}}/api/chats/admin
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "New Chat"
}

# Consumer ========================================================================

### GET /api/chat gets the chat for the owner
GET http://{{host}}/api/chats
Authorization: Bearer {{token}}

### Update chat metadata
PUT http://{{host}}/api/chats/662d58385ea8cb08ee16d1cc
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Chat 2"
}

### Upload a logo for the chat
PUT http://{{host}}/api/chats/662d58385ea8cb08ee16d1cc/logo
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----boundary

------boundary
Content-Disposition: form-data; name="file"; filename="example.txt"
Content-Type: image/jpg

< ./data/profile.jpg
------boundary--

### Checks urls that can be added as resources
POST http://{{host}}/api/chats/662d58385ea8cb08ee16d1cc/resources/web/inspect
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "url": "https://js.langchain.com/docs/use_cases/question_answering/streaming"
}

### Add a web resource
POST http://{{host}}/api/chats/662d58385ea8cb08ee16d1cc/resources/web
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "type": "web",
    "urls": ["https://js.langchain.com/docs/use_cases/question_answering/streaming"]
}

### Delete resource
DELETE http://{{host}}/api/chats/662d58385ea8cb08ee16d1cc/resources/662fb7a802f5056e3ebd60ff
Authorization: Bearer {{token}}

# Public ========================================================================

### Gets the chat for the consumer
GET http://{{host}}/api/chats/published

### Gets the chat for the consumer
GET http://{{host}}/api/chats/662d58385ea8cb08ee16d1cc

### Generate response for question
POST http://{{host}}/api/chats/662d58385ea8cb08ee16d1cc/messages
Content-Type: application/json

{
    "question": "How does streaming work with langchain?",
    "chatHistory": []
}
