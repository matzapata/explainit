# Public origin visitors and the Owner dashboard share (Caddy on port 80).
PUBLIC_URL=http://localhost

# Required — OpenRouter API key for chat + embeddings.
OPENROUTER_API_KEY=

# Dashboard login (set both to require sign-in). Leave empty only for local trials.
HTTP_AUTH_USERNAME=admin
HTTP_AUTH_PASSWORD=changeme

# JWT signing secret. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional overrides
# POSTGRES_PASSWORD=explainit
# MINIO_ROOT_USER=explainit
# MINIO_ROOT_PASSWORD=explainitsecret
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-ada-002
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# SCRAPER_PROVIDER=puppeteer
# FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
